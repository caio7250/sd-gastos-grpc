# Copie para .env se precisar mudar algo. Todos são opcionais.

# Onde o Gateway está, para o proxy do servidor de desenvolvimento (npm run dev).
# Em produção quem faz esse papel é o nginx da vm-client — veja infra/nginx.conf.
GATEWAY_URL=http://localhost:8000

# Porta do servidor de desenvolvimento.
WEB_PORT=5173
